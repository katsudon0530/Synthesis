  ruleText: {fileID: 6256378203183693881}
  ruleAllText:
  - "\u30EB\u30FC\u30EB\u8AAC\u660E\n\u30AB\u30FC\u30C9\u30923\u679A\u307E\u3067\u9078\u3076\n\n\u6C7A\u5B9A\u30DC\u30BF\u30F3\u3092\u62BC\u3059\u30681\u679A\u76EE\u304B\u3089\u9806\u306B\u30AB\u30FC\u30C9\u3092\u4F7F\u7528\u3057\u3066\u3044\u304F\n\n\u5408\u6210\u30DC\u30BF\u30F3\u3092\u62BC\u3059\u3068\u5148\u982D\u306E\u30AB\u30FC\u30C9\u304C\u5F37\u5316\u3055\u308C\u308B\n\n\u52DD\u5229\u6761\u4EF6\u3000\u76F8\u624B\u306EHP\u30920\u306B\u3059\u308B\n"
  - "\u30EB\u30FC\u30EB\u8AAC\u660E\n\u6700\u5927\u3067\u30AB\u30FC\u30C9\u306E\u679A\u6570\u306F15\u679A\n\n\u30A8\u30CD\u30DF\u30FC\u30BB\u30EC\u30AF\u30C8\u753B\u9762\u3067\u30C7\u30C3\u30AD\u306E\u6539\u9020\u304C\u3067\u304D\u308B"
  - "\u30EB\u30FC\u30EB\u8AAC\u660E\n\u653B\u6483\u30AB\u30FC\u30C9\u306F\n\u653B\u6483\u30FB\u9632\u5FA1\u30FB\u56DE\u5FA9\u306E\u5F8C\u306B\u51FA\u3059\u3068\u5F37\u304F\u306A\u308B\n\u9B54\u6CD5\u306E\u5F8C\u306B\u51FA\u3059\u3068\u5F31\u304F\u306A\u308B\n"
  - "\u30EB\u30FC\u30EB\u8AAC\u660E\n\u9B54\u6CD5\u30AB\u30FC\u30C9\u306F\n\u653B\u6483\u306E\u5F8C\u306B\u51FA\u3059\u3068\u3068\u3066\u3082\u5F37\u304F\u306A\u308B\n\u9632\u5FA1\u30FB\u56DE\u5FA9\u306E\u5F8C\u306B\u51FA\u3059\u3068\u5C11\u3057\u5F37\u304F\u306A\u308B\n\u9B54\u6CD5\u306E\u5F8C\u306B\u51FA\u3059\u3068\u5F31\u304F\u306A\u308B"
  - "\u30EB\u30FC\u30EB\u8AAC\u660E\n\u9632\u5FA1\u30AB\u30FC\u30C9\u306F\n\u9632\u5FA1\u306E\u5F8C\u306B\u51FA\u3059\u3068\u3068\u3066\u3082\u5F37\u304F\u306A\u308B\n\u56DE\u5FA9\u306E\u5F8C\u306B\u51FA\u3059\u3068\u5C11\u3057\u5F37\u304F\u306A\u308B\n\u653B\u6483\u3068\u9B54\u6CD5\u306E\u5F8C\u306B\u51FA\u3059\u3068\u5F31\u304F\u306A\u308B"
